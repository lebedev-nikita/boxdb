{
  "name": "@boxdb/drizzle-adapter",
  "version": "0.4.1",
  "description": "Asynchronous Drizzle ORM adapter for BoxDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lebedev-nikita/boxdb.git",
    "directory": "packages/drizzle-adapter"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "node -e \"throw new Error('Publish verified archives with just publish-npm')\"",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && oxlint src test && oxfmt --check src test package.json tsconfig.json tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@boxdb/client": "workspace:*",
    "@types/node": "26.6.5",
    "drizzle-orm": "^0.45.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@boxdb/client": "^0.4.1",
    "drizzle-orm": "^0.45.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
