{
  "name": "@boxdb/client",
  "version": "0.1.0",
  "description": "BoxDB queries and SQLite driver backed by the Rust core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lebedev-nikita/boxdb.git",
    "directory": "packages/typescript"
  },
  "files": [
    "dist",
    "native/boxdb.node",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc --noEmit && oxlint src test scripts && oxfmt --check src test scripts package.json tsconfig.json tsconfig.build.json tsconfig.runtime.json",
    "test": "vitest run",
    "build:release": "bun run scripts/build.ts --release"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
