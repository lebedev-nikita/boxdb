    },
    {
      "name": "Install command strip",
      "kind": "custom",
      "description": "A selectable command with a compact copy control. Copy behavior and announcements remain in the page script.",
      "html": "<div class=\"ds-install\"><span aria-hidden=\"true\">$</span><code>npm install @boxdb/client</code><button class=\"ds-copy\" type=\"button\" aria-label=\"Copy install command\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"13\" rx=\"2\"/><path d=\"M16 5V3H4v13h2\"/></svg><span>Copy</span></button></div>",
      "css": ".ds-install{font-family:\"Manrope Variable\",sans-serif;display:flex;gap:24px;align-items:center;min-height:74px;padding:14px 3.7%;background:var(--pale,#dff3f6);color:var(--ink,#10232d)}.ds-install>span{font:20px ui-monospace,SFMono-Regular,Consolas,monospace}.ds-install code{font:18px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-x:auto;white-space:nowrap;min-width:0}.ds-copy{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:8px;margin-left:auto;padding:10px 4px 10px 12px;border:0;background:transparent;color:inherit;cursor:pointer;font-size:13px;flex-shrink:0}.ds-copy:hover{color:#056b84}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-hero-primary:focus-visible,.ds-client:focus-visible,.ds-copy:focus-visible{outline:3px solid #075c75;outline-offset:5px}@media(max-width:760px){.ds-install{padding:12px 20px;gap:12px;min-height:66px}.ds-install code{font-size:12px}.ds-copy{padding-inline:4px}.ds-copy span{display:none}}"
    },
